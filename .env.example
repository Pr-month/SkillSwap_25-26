# Конфигурация приложения
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Конфигурация базы данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
