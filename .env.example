# Конфигурация JWT токенов
JWT_ACCESS_SECRET=your-very-secret-access-key-here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-very-secret-refresh-key-here
JWT_REFRESH_EXPIRATION=7d
