# Конфигурация для тестовой среды
NODE_ENV=test

# Конфигурация базы данных PostgreSQL для тестов
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=skillswap_test

# Конфигурация JWT токенов
JWT_ACCESS_SECRET=your-very-secret-access-key-here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-very-secret-refresh-key-here
JWT_REFRESH_EXPIRATION=7d

# Данные администратора для тестов
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
